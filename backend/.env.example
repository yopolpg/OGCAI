# OGCAI Backend Environment Configuration Example
# Copy this file to backend/.env and adjust values as needed.

OGCAI_APP_NAME="OGCAI Core Engine"
OGCAI_APP_VERSION="1.0.0"
OGCAI_DEBUG=True

OGCAI_HOST="127.0.0.1"
OGCAI_PORT=8000

OGCAI_OLLAMA_BASE_URL="http://127.0.0.1:11434"
OGCAI_OLLAMA_TIMEOUT_SECONDS=120.0
OGCAI_OLLAMA_KEEP_ALIVE="30m"

OGCAI_DEFAULT_MODEL="qwen2.5-coder:7b"
OGCAI_ADVISOR_MODEL="llama3.1:8b"
OGCAI_HEAVY_LOGIC_MODEL="deepseek-coder-v2:16b"
OGCAI_FAST_WORKER_MODEL="qwen2.5:3b"
OGCAI_FALLBACK_MODEL="phi3.5:latest"
